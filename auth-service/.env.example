# A 32+ character, random secret. Never commit its real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
APP_ENV=development
NODE_ENV=development
DATABASE_URL=postgresql://nexus:nexus-local-only@localhost:5432/nexus_auth
BETTER_AUTH_URL=http://localhost:3001
AUTH_PORT=3001
APP_ORIGIN=http://localhost:5173

# Set to true in production once RESEND_API_KEY and EMAIL_FROM are configured.
REQUIRE_EMAIL_VERIFICATION=false
RESEND_API_KEY=
EMAIL_FROM=NEXUS <security@example.com>

# Required when the app, API and auth service live on subdomains of one domain.
# COOKIE_DOMAIN=
