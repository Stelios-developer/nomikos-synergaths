OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Dedicated PostgreSQL/pgvector runtime role (never use a database owner).
VECTOR_DATABASE_URL=postgresql://dmc_runtime:replace-with-random-password@localhost:5441/dmc
VECTOR_DB_POOL_SIZE=4
# Dedicated queue-only login; cannot read document/vector/job tables directly.
ANALYSIS_DISPATCH_ENABLED=true
ANALYSIS_DISPATCH_DATABASE_URL=postgresql://dmc_dispatcher:replace-with-different-random-password@localhost:5441/dmc
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_CHUNKS_PER_QUERY=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
LLM_PROVIDER=anthropic
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Better Auth / PostgreSQL. Production must set AUTH_REQUIRED=true and use a
# PostgreSQL database shared only with the Better Auth service.
AUTH_REQUIRED=false
DATABASE_URL=postgresql://nexus:nexus-local-only@localhost:5432/nexus_auth
# Must exactly match auth-service/BETTER_AUTH_SECRET. Keep it server-side.
BETTER_AUTH_SECRET=replace-with-the-same-long-random-secret
AUTH_COOKIE_PREFIX=nexus
REQUIRE_VERIFIED_EMAIL=true
AUTH_DB_POOL_SIZE=10

# Admin-only diagnostics; never publish a browser-side VITE_* equivalent.
ADMIN_API_KEY=
# Deprecated browser API-key guard; leave disabled for Better Auth deployments.
LEGACY_API_KEY_ENABLED=false
N8N_WEBHOOK_API_KEY=
N8N_ORCHESTRATOR_URL=http://localhost:5678/webhook/nexus-agent-orchestrator/case
DOCUMENT_CASE_DB_PATH=./document_cases.db
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=250
MAX_DOCUMENTS_PER_USER=100
MAX_STORAGE_MB_PER_USER=500
# Production PDF ingress fails closed without this private, network-restricted
# service. The worker scans with ClamAV and returns a visually reconstructed PDF.
PDF_SECURITY_URL=
PDF_SECURITY_TOKEN=
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_SUPERVISOR=5/minute
RATE_LIMIT_PANEL=5/minute
RATE_LIMIT_RESEARCH=8/minute
RATE_LIMIT_AUDIT=15/minute
RATE_LIMIT_INTELLIGENCE=4/minute
LOG_LEVEL=INFO
