OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
CHROMA_PERSIST_DIR=./chroma_db
MAX_CHUNKS_PER_QUERY=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
LLM_PROVIDER=anthropic
ALLOWED_ORIGINS=*
API_KEY=
# Gates ONLY code execution (the Action Agent). Falls back to API_KEY if
# left blank. Leave both this AND API_KEY blank and code execution fails
# closed — it refuses rather than silently running unsandboxed code.
AGENT_API_KEY=
RATE_LIMIT_QUERY=20/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_AGENT=10/minute
